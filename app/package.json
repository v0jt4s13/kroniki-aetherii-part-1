{
  "name": "kroniki-aetherii",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:prefix": "npm run build && node --test tests/prefix-api.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "node server/start.mjs",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build --config vite.game.config.ts && node scripts/prepare-sites-build.mjs",
    "start": "node server/start.mjs --production",
    "test": "node --test tests/runtime-env.test.mjs tests/traffic.test.mjs tests/traffic-api.test.mjs tests/doubles.test.mjs tests/party-api.test.mjs tests/aetherii.test.mjs tests/engine.test.mjs tests/api.test.mjs tests/bot.test.mjs tests/ai-api.test.mjs tests/accounts-api.test.mjs tests/accounts.test.mjs",
    "test:doubles-browser": "node scripts/browser-doubles-check.mjs",
    "test:party-browser": "node scripts/browser-party-check.mjs",
    "test:aetherii-browser": "node scripts/browser-aetherii-check.mjs",
    "test:ai-browser": "node scripts/browser-ai-check.mjs",
    "test:features-browser": "node scripts/browser-features-check.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/roboto": "5.2.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "google-auth-library": "^10.9.1",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
