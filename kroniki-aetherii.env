APP_NAME="kroniki-aetherii"
SERVICE_NAME="kroniki-aetherii"
CONTAINER_NAME="kroniki-aetherii"

APP_FOLDER_NAME="kroniki-aetherii"
APP_DIR="/opt/apps/${APP_FOLDER_NAME}"
COMPOSE_FILE="${APP_DIR}/docker-compose.yml"
DOCKER_RUNTIME_ENV="${APP_DIR}/.env"

DOCKER_IMAGE="ghcr.io/v0jt4s13/kroniki-aetherii-part-1"
DOCKER_IMAGE_TAG="latest"

DOCKER_REGISTRY="ghcr.io"
DOCKER_REGISTRY_USERNAME="v0jt4s13"
DOCKER_REGISTRY_TOKEN_FILE="/opt/apps/kroniki-aetherii/ghcr-token"
DOCKER_PORT=4173
DOCKER_BIND="127.0.0.1:${DOCKER_PORT}"

DOMAIN="ops02.jdblayer.com"
NGINX_SITE="/etc/nginx/sites-available/moderacja.conf"
NGINX_STRATEGY="prefix"
URL_PREFIX="/kroniki-aetherii"

DOCKER_CONTAINER_PORT=4173
DOCKER_DATA_DIR="${APP_DIR}/data"
DOCKER_DATA_TARGET="/data"
